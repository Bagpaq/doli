# ============================================================
# Sophia — Dental Voice Agent  |  Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# ── OpenAI ───────────────────────────────────────────────────────────
# Your OpenAI API key — must have Realtime API access
OPENAI_API_KEY=sk-...

# ── LiveKit ──────────────────────────────────────────────────────────
# Your LiveKit Cloud (or self-hosted) endpoint
LIVEKIT_URL=wss://your-project.livekit.cloud

# LiveKit API credentials (from your LiveKit dashboard)
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SIP Trunk ID for outbound reminder calls (optional)
# Create a SIP trunk in the LiveKit dashboard and paste its ID here
LIVEKIT_SIP_TRUNK_ID=ST_xxxxxxxxxxxxxxxxxx

# ── Google Calendar ───────────────────────────────────────────────────
# The calendar ID to read/write appointments to.
# Format: xxxxxxxx@group.calendar.google.com  (or "primary" for main calendar)
GOOGLE_CALENDAR_ID=primary

# Path to your Google Service Account JSON key file.
# The service account must have:
#   • "Google Calendar API" enabled
#   • "Gmail API" enabled  (with domain-wide delegation for Gmail send)
#   • Editor access to the above calendar
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/run/secrets/google-service-account.json

# ── Gmail ─────────────────────────────────────────────────────────────
# The email address Sophia sends confirmation/cancellation emails FROM.
# The service account must be allowed to impersonate this address
# via domain-wide delegation in Google Workspace Admin.
GMAIL_SENDER_EMAIL=sophia@brightsmileaustin.com

# ── Clinic config ─────────────────────────────────────────────────────
# Path to the YAML config file for the active clinic
CLINIC_CONFIG_PATH=config/businesses/dental-clinic.yaml
