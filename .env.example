# Required: Your Anthropic API key
ANTHROPIC_API_KEY=your_api_key_here

# Optional: Weekly API budget in USD (daily limit = 8% of this)
# Default: $10/week → $0.80/day
WEEKLY_BUDGET_USD=10.0

# Optional: Your initial investment amount in USD
# Agent will ask before spending any of it
INITIAL_INVESTMENT_USD=100.0
